generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String              @id @default(uuid())
  authId            String?             @unique
  email             String?             @unique
  username          String?             @unique
  displayName       String?
  avatarUrl         String?
  bio               String?
  interests         String[]            @default([])
  showMilestones    Boolean             @default(true)
  enableInitiative  Boolean             @default(true)
  quietHoursStart   String              @default("23:00")
  quietHoursEnd     String              @default("08:00")
  createdAt         DateTime            @default(now())
  conversations     Conversation[]
  relationStates    RelationshipState[]
  memories          Memory[]
  notifications     Notification[]
  scenarioAttempts  ScenarioAttempt[]
  skillScore        UserSkillScore?
  progress          UserProgress?
}

model Agent {
  id             String              @id
  name           String
  shortBio       String
  archetype      String
  voiceStyle     String
  config         Json
  createdAt      DateTime            @default(now())
  conversations  Conversation[]
  relationStates RelationshipState[]
  memories       Memory[]
  attempts       ScenarioAttempt[]
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String
  agentId   String
  mode      String    @default("practice")
  scenarioId String?
  sessionMeta Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id])
  agent     Agent     @relation(fields: [agentId], references: [id])
  scenario  Scenario? @relation(fields: [scenarioId], references: [id])
  messages  Message[]
  attempts  ScenarioAttempt[]

  @@index([userId, agentId, mode])
  @@index([userId, agentId, mode, scenarioId])
  @@index([mode, createdAt])
  @@index([scenarioId])
}

model Message {
  id                 String       @id @default(uuid())
  conversationId     String
  senderRole         String
  content            String
  toneClassification String?
  responseMetadata   Json?
  createdAt          DateTime     @default(now())
  conversation       Conversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, createdAt])
}

model RelationshipState {
  id                String   @id @default(uuid())
  userId            String
  agentId           String
  interest          Int      @default(30)
  trust             Int      @default(20)
  comfort           Int      @default(20)
  tension           Int      @default(30)
  respect           Int      @default(30)
  attachment        Int      @default(10)
  emotionalOpenness Int      @default(15)
  conversationDepth Int      @default(10)
  initiativeBalance String   @default("user_leads")
  dynamicAlignment  Int      @default(30)
  stage             Int      @default(0)
  currentMood       String   @default("receptive")
  lastInteractionAt DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id])
  agent             Agent    @relation(fields: [agentId], references: [id])

  @@unique([userId, agentId])
}

model Memory {
  id              String   @id @default(uuid())
  userId          String
  agentId         String
  type            String
  content         String
  salience        Float
  confidence      Float
  emotionalWeight Float
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
  agent           Agent    @relation(fields: [agentId], references: [id])

  @@index([userId, agentId, type])
}

model Milestone {
  id        String   @id @default(uuid())
  userId    String
  agentId   String
  type      String
  label     String
  detail    String?
  createdAt DateTime @default(now())

  @@index([userId, agentId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  agentId   String
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, read, createdAt])
}

model Scenario {
  id                String            @id @default(uuid())
  slug              String            @unique
  title             String
  description       String
  objective         String
  context           String
  difficulty        String            @default("normal")
  category          String
  maxMessages       Int?
  timeLimit         Int?
  unlockRequirement Json?
  agentConstraints  Json?
  successCriteria   Json
  tips              String[]          @default([])
  order             Int               @default(0)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  attempts          ScenarioAttempt[]
  conversations     Conversation[]

  @@index([isActive, order])
  @@index([category, difficulty])
}

model ScenarioAttempt {
  id             String       @id @default(uuid())
  userId         String
  scenarioId     String
  conversationId String
  agentId        String
  status         String       @default("in_progress")
  score          Json?
  feedback       Json?
  xpEarned       Int          @default(0)
  hintsUsed      Int          @default(0)
  hintPenaltyScore Float      @default(0)
  hintPenaltyXp  Int          @default(0)
  rawOverallScore Float?
  adjustedOverallScore Float?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id])
  scenario       Scenario     @relation(fields: [scenarioId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  agent          Agent        @relation(fields: [agentId], references: [id])

  @@index([userId, scenarioId])
  @@index([userId, status])
  @@index([conversationId])
}

model UserSkillScore {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  confidence             Float    @default(50)
  warmth                 Float    @default(50)
  curiosity              Float    @default(50)
  calibration            Float    @default(50)
  authenticity           Float    @default(50)
  pressureLevel          Float    @default(50)
  awkwardness            Float    @default(50)
  emotionalIntelligence  Float    @default(50)
  boundaryRespect        Float    @default(50)
  conversationalMomentum Float    @default(50)
  overallScore           Float    @default(50)
  totalSessions          Int      @default(0)
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id])
}

model UserProgress {
  id                 String    @id @default(uuid())
  userId             String    @unique
  level              Int       @default(1)
  xp                 Int       @default(0)
  xpToNextLevel      Int       @default(100)
  totalSessions      Int       @default(0)
  scenariosCompleted Int       @default(0)
  achievements       Json      @default("[]")
  unlockedScenarios  String[]  @default([])
  unlockedAgents     String[]  @default([])
  streakDays         Int       @default(0)
  lastSessionAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id])
}
